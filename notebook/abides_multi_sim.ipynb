   "source": [
    "# 전략 클래스\n",
    "class policyPassive:\n",
    "    def __init__(self):\n",
    "        self.name = 'passive'\n",
    "        \n",
    "    def get_action(self, state):\n",
    "        return 1\n",
    "        \n",
    "class policyAggressive:\n",
    "    def __init__(self):\n",
    "        self.name = 'aggressive'\n",
    "        \n",
    "    def get_action(self, state):\n",
    "        return 0\n",
    "    \n",
    "class policyRandom:\n",
    "    def __init__(self):\n",
    "        self.name = 'random'\n",
    "        \n",
    "    def get_action(self, state):\n",
    "        return np.random.choice([0, 1])\n",
    "    \n",
    "class policyRandomWithNoAction:\n",
    "    def __init__(self):\n",
    "        self.name = 'random_no_action'\n",
    "        \n",
    "    def get_action(self, state):\n",
    "        return np.random.choice([0, 1, 2])\n"
   ]
  },
